# Copier ce fichier en .env.local (ne jamais le commiter) et remplir les valeurs.
# Sur Vercel : Project Settings > Environment Variables.

# URL publique du site (sans slash final). Local : http://localhost:3000
SITE_URL=http://localhost:3000

# Base PostgreSQL Neon. Utiliser l'URL avec pooler en production, avec ?sslmode=require
DATABASE_URL=

# Stripe (cles de TEST d'abord : sk_test_...)
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...), voir SETUP.md
STRIPE_WEBHOOK_SECRET=

# E-mails (Resend). Sans cle, les e-mails sont seulement ecrits dans la console.
RESEND_API_KEY=
MAIL_FROM=TRIPLEX <commandes@votre-domaine.com>
# Adresse qui recoit les alertes de nouvelles commandes
ADMIN_EMAIL=

# Espace /admin
ADMIN_PASSWORD=
# Chaine aleatoire d'au moins 32 caracteres (voir SETUP.md pour la generer)
ADMIN_SESSION_SECRET=

# Images (photos des pieces, logo) : bucket S3 prive + CloudFront, voir SETUP.md section 6 bis.
# Nom du bucket sans point, region (ex. eu-west-3)
S3_BUCKET=
S3_REGION=
# Utilisateur IAM limite a s3:PutObject / s3:DeleteObject sur <bucket>/media/*
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL publique CloudFront en https, sans slash final (redeployer apres modification)
CLOUDFRONT_URL=
# Optionnel : dossier du bucket (defaut : media)
S3_PREFIX=
